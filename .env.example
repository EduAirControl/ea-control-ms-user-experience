# ms-user-experience - variables de entorno.
# Copia a .env y ajusta los valores. No subas nunca un .env con secretos.

# Servidor
SERVER_PORT=3006

# PostgreSQL (ADR-003)
POSTGRES_URL=jdbc:postgresql://localhost:5439/eduaircontrol_user_experience
POSTGRES_USER=user_experience_user
POSTGRES_PASSWORD=change-me
SHOW_SQL=false
DB_CHANGELOG_CONTEXTS=

# Seguridad (ADR-006/018): access tokens RS256 validados contra el JWKS de ms-security
JWKS_URI=http://localhost:8081/api/v1/auth/jwks
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ / mensajeria (ADR-007/016): replica ambiente->institucion
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MESSAGING_LISTENERS_AUTO_STARTUP=true
MESSAGING_MAX_RETRIES=4
MESSAGING_INITIAL_RETRY_INTERVAL_MS=1000
CLASSROOM_EVENTS_EXCHANGE=eduaircontrol.classroom
CLASSROOM_EVENTS_QUEUE=eduaircontrol.classroom.ms-user-experience
CLASSROOM_EVENTS_ROUTING_KEY=classroom.educational_environment.*

# Backfill historico desde el monolito (temporal)
BACKFILL_ENABLED=false
BACKFILL_INITIAL_RUN=false
