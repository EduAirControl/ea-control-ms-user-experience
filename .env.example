# ms-user-experience - environment variables.
# Copy to .env and adjust the values. Never commit a .env with secrets.

# Server
SERVER_PORT=3006

# PostgreSQL (ADR-003)
POSTGRES_URL=jdbc:postgresql://localhost:5439/eduaircontrol_user_experience
POSTGRES_USER=user_experience_user
POSTGRES_PASSWORD=change-me
SHOW_SQL=false
DB_CHANGELOG_CONTEXTS=

# Security (ADR-006/018): RS256 access tokens validated against the ms-security JWKS
JWKS_URI=http://localhost:8081/api/v1/auth/jwks
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ / messaging (ADR-007/016): environment -> institution replica
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MESSAGING_LISTENERS_AUTO_STARTUP=true
MESSAGING_MAX_RETRIES=4
MESSAGING_INITIAL_RETRY_INTERVAL_MS=1000
CLASSROOM_EVENTS_EXCHANGE=eduaircontrol.classroom
CLASSROOM_EVENTS_QUEUE=eduaircontrol.classroom.ms-user-experience
CLASSROOM_EVENTS_ROUTING_KEY=classroom.educational_environment.*

# Historical backfill from the monolith (temporary)
BACKFILL_ENABLED=false
BACKFILL_INITIAL_RUN=false
